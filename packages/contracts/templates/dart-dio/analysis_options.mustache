analyzer:
  language:
    strict-inference: true
    strict-raw-types: true
    strict-casts: false
  exclude:
    - test/*.dart
    - lib/src/model/*.g.dart
  errors:
    deprecated_member_use_from_same_package: ignore
    # OpenAPI Generator imports oneOf branch models that json_serializable does not use.
    unused_import: ignore
