# ==============================================================================
# Environment Configuration
# ==============================================================================
# Copy this file to .env and run `make setup`. APP_NAME is set automatically
# from the project folder name. All other variables below are optional;
# docker-compose.yaml provides sensible fallbacks.
# ==============================================================================

# ------------------------------------------------------------------------------
# Project
# ------------------------------------------------------------------------------
# Prefix for container names and DB credentials. Auto-set by setup.sh from
# the folder name. Override only if you need a custom name.
#APP_NAME=

# ------------------------------------------------------------------------------
# Image versions
# ------------------------------------------------------------------------------
# Pin specific versions to lock your stack, or leave commented to pull the
# defaults shown. These are passed as build args to Dockerfiles and/or used
# as image tags in docker-compose.yaml.

# PHP base image tag (e.g. cli, 8.3-cli, 8.2-cli-alpine)
# Default: cli
#PHP_VERSION=cli

# Composer image tag used to copy the binary into the API image
# Default: latest
#COMPOSER_VERSION=latest

# Node.js image tag for the website build and production stages (e.g. 20, 22-alpine)
# Default: latest
#NODE_VERSION=latest

# MariaDB image tag (e.g. 11.4, 10.11)
# Default: latest
#MARIADB_VERSION=latest

# Redis image tag (e.g. 7, 7-alpine)
# Default: latest
#REDIS_VERSION=latest

# Nginx image tag — used by the production proxy service (e.g. 1.27, stable-alpine)
# Default: latest
#NGINX_VERSION=latest

# Cloudflare cloudflared image tag — used by the production tunnel service
# Default: latest
#CLOUDFLARED_VERSION=latest

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Credentials for the MariaDB container. Defaults to APP_NAME for database,
# username, and password so everything works without configuration.
#DB_ROOT_PASSWORD=root
#DB_DATABASE=
#DB_USERNAME=
#DB_PASSWORD=
