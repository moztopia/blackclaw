#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${ROOT_DIR}/packages/darkclaw-census-api-client-python/.venv/bin/python"

if [[ ! -x "${PYTHON}" ]]; then
  echo "blackclaw: Python client environment is not installed" >&2
  echo "Run 'make install-cli' from ${ROOT_DIR}" >&2
  exit 1
fi

exec "${PYTHON}" "${ROOT_DIR}/cli/blackclaw.py" "$@"
